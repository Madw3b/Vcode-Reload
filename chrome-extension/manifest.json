{
  "manifest_version": 3,
  "name": "Dev Live Reload",
  "short_name": "Live Reload",
  "version": "3.0.0",
  "description": "Reloads your local dev pages when the VS Code watcher reports a file change. Live online status, activity log and ignore list.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["reload.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Dev Live Reload",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  }
}
